# Contact form endpoint.
#
# Without this the form falls back to opening the visitor's mail client, which
# works but loses anyone without a configured desktop mail app.
#
# Formspree:  https://formspree.io  -> create a form, paste its endpoint here
# Netlify:    add `netlify` and `data-netlify="true"` to the <form> instead
#
# Vite only exposes variables prefixed with VITE_ to the client.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
